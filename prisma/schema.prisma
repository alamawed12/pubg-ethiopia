generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id            String   @id @default(cuid())
  referenceId   String   @unique
  qrToken       String   @unique

  // Player Identity
  fullName      String
  inGameName    String
  pubgUid       String
  phoneNumber   String
  countryCode   String   @default("+251")
  cityRegion    String

  // Participation
  category      String   // attendee, tournament_player, team_rep, content_creator, volunteer
  teamName      String?
  tournamentInterest Boolean @default(false)
  squadDetails  String?

  // ID Document
  idFrontImage  String?
  idBackImage   String?

  // Ticket Tier
  ticketTier    String   @default("STANDARD") // STANDARD, VIP
  vipPrice      Int?

  // Status
  status        String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, WAITLISTED, CHECKED_IN
  phoneVerified Boolean  @default(false)

  // Check-in
  checkedInAt   DateTime?
  checkedInBy   String?

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([phoneNumber])
  @@index([pubgUid])
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String   @default("Admin")
  role          String   @default("admin") // admin, super_admin

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  adminEmail    String
  action        String   // e.g., "REGISTRATION_APPROVED", "REGISTRATION_REJECTED", "CHECK_IN"
  targetId      String?  // registration ID or other entity
  details       String?  // JSON string with additional info
  ipAddress     String?

  createdAt     DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
  @@index([createdAt])
}

model Announcement {
  id            String   @id @default(cuid())
  title         String
  content       String
  type          String   @default("info") // info, warning, update
  isActive      Boolean  @default(true)

  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

model OTPVerification {
  id            String   @id @default(cuid())
  phoneNumber   String
  code          String
  expiresAt     DateTime
  verified      Boolean  @default(false)
  attempts      Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([phoneNumber])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
